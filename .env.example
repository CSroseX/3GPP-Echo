# Set to true for a remote OpenAI-compatible API, false for a local LLM (Ollama, qwen3.5:4b)
USE_REMOTE_LLM=true

# OpenRouter (used in development). When this key is set it is preferred.
OPEN_ROUTER_API_KEY=your_openrouter_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-oss-20b

# Or any other OpenAI-compatible provider:
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=model_name

# Optional: how long a reasoning model thinks before answering (low | medium | high).
# Default: low (src/config.py); set it empty for the model's own default. Sent to OpenRouter only.
# GENERATE_REASONING_EFFORT=low

# Optional tracing (src/obs/tracing.py). Leave LANGFUSE_HOST unset to run untraced.
# These values match the local Langfuse provisioned by docker-compose.yml.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev

# Budget protection (src/api/quota.py). Empty URL = quota off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string that signs visitor tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISITOR_TOKEN_SECRET=
