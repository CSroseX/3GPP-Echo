# Set to true for remote OpenAI-compatible API, false for local LLM (e.g. Ollama)
USE_REMOTE_LLM=true

# API key for remote LLM provider
OPENAI_API_KEY=your_api_key_here

# Base URL for OpenAI-compatible endpoint (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Target model name (e.g. qwen/qwen3.6-27b)
MODEL_NAME=model_name

# Optional tracing (src/obs/tracing.py). Leave LANGFUSE_HOST unset to run untraced.
# These values match the local Langfuse provisioned by docker-compose.yml.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
